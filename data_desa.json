nopsis": "", "video_highlight": "", "video_produksi": "", "video_tahun": "", "video_durasi": "", "video_link": "", "maps_embed_url": "", "sosmed_instagram": "", "sosmed_facebook": "", "sosmed_youtube": "", "sosmed_whatsapp": "", "sosmed_tiktok": "", "updated_at": "2026-08-12T11:49:35.939Z"}}, {"model": "potensi.kategoripotensi", "pk": 1, "fields": {"nama": "Pertanian", "slug": "pertanian", "ikon": "bi-tree", "deskripsi_singkat": "Potensi lahan pertanian dengan hasil panen melimpah.", "foto_cover": "", "urutan": 0, "is_published": true}}, {"model": "potensi.kategoripotensi", "pk": 2, "fields": {"nama": "Peternakan", "slug": "peternakan", "ikon": "bi-egg", "deskripsi_singkat": "Potensi budidaya dan peternakan warga setempat.", "foto_cover": "", "urutan": 1, "is_published": true}}, {"model": "potensi.kategoripotensi", "pk": 3, "fields": {"nama": "Budaya", "slug": "budaya", "ikon": "bi-palette", "deskripsi_singkat": "Potensi kesenian dan kebudayaan lokal warga.", "foto_cover": "", "urutan": 2, "is_published": true}}, {"model": "potensi.kategoripotensi", "pk": 4, "fields": {"nama": "UMKM", "slug": "umkm", "ikon": "bi-shop", "deskripsi_singkat": "Usaha Mikro Kecil dan Menengah di Sumberagung.", "foto_cover": "", "urutan": 3, "is_published": true}}, {"model": "potensi.itempotensi", "pk": 1, "fields": {"kategori": 1, "judul": "Komoditas Pertanian Unggulan", "slug": "pertanian-unggulan", "deskripsi": "<p>Sebagian besar wilayah desa merupakan lahan subur yang digunakan masyarakat untuk menanam berbagai komoditas seperti <strong>tembakau, padi, jagung, cabai, singkong, ubi, kacang hijau, kedelai, sayuran, dan buah-buahan</strong>.</p><p>Data ini didapatkan dari pemetaan lahan dan wawancara dengan kelompok tani desa.</p>", "foto": "", "sumber_data": "Wawancara Kelompok Tani", "is_published": true, "urutan": 0, "created_at": "2026-08-12T16:21:44.806Z", "updated_at": "2026-08-12T16:21:44.806Z"}}, {"model": "potensi.itempotensi", "pk": 2, "fields": {"kategori": 2, "judul": "Sektor Peternakan Warga", "slug": "peternakan-warga", "deskripsi": "<p>Banyak warga desa yang memiliki usaha peternakan mandiri di pekarangan maupun lahan khusus. Beberapa jenis hewan ternak utama meliputi <strong>sapi, kambing, ayam, itik, dan burung puyuh</strong>.</p>", "foto": "", "sumber_data": "Data Verifikasi Dusun", "is_published": true, "urutan": 0, "created_at": "2026-08-12T16:21:44.809Z", "updated_at": "2026-08-12T16:21:44.809Z"}}, {"model": "potensi.itempotensi", "pk": 3, "fields": {"kategori": 3, "judul": "Kesenian Barong / Barongan", "slug": "kesenian-barong", "deskripsi": "<p>Barongan adalah salah satu kesenian tradisional yang masih dilestarikan oleh masyarakat. Kesenian ini sering ditampilkan pada acara-acara desa maupun hajatan warga.</p>", "foto": "", "sumber_data": "Eksplorasi Budaya KKN", "is_published": true, "urutan": 0, "created_at": "2026-08-12T16:21:44.813Z", "updated_at": "2026-08-12T16:21:44.813Z"}}, {"model": "potensi.itempotensi", "pk": 4, "fields": {"kategori": 4, "judul": "Daftar UMKM dan Usaha Warga", "slug": "umkm-desa", "deskripsi": "<p>Desa ini memiliki puluhan penggiat UMKM yang memproduksi makanan, kerajinan, hingga jasa. Untuk melihat detail katalog UMKM hasil pendampingan program KKN, silakan kunjungi halaman khusus UMKM kami.</p> <p><a href=\"/umkm/\" class=\"btn btn-success text-white\">Lihat Katalog UMKM</a></p>", "foto": "", "sumber_data": "", "is_published": true, "urutan": 0, "created_at": "2026-08-12T16:21:44.816Z", "updated_at": "2026-08-12T16:21:44.817Z"}}, {"model": "umkm.kategoriumkm", "pk": 1, "fields": {"nama": "Makanan & Minuman", "slug": "makanan-minuman"}}, {"model": "umkm.kategoriumkm", "pk": 2, "fields": {"nama": "Kerajinan", "slug": "kerajinan"}}, {"model": "umkm.kategoriumkm", "pk": 3, "fields": {"nama": "Jasa", "slug": "jasa"}}, {"model": "umkm.kategoriumkm", "pk": 4, "fields": {"nama": "Pertanian", "slug": "pertanian"}}, {"model": "umkm.umkm", "pk": 1, "fields": {"nama_usaha": "Kerupuk Rambak Bu Sri", "slug": "kerupuk-rambak-bu-sri", "nama_pemilik": "Ibu Sri Wahyuni", "kategori": 1, "dusun": "Dusun Krajan", "deskripsi": "<p>Usaha kerupuk rambak sapi khas desa Sumberagung yang telah berdiri sejak tahun 2010. Menggunakan bahan baku pilihan dan dijemur langsung di bawah sinar matahari.</p>", "produk_unggulan": "Kerupuk Rambak Mentah, Kerupuk Rambak Matang rasa Original", "foto_utama": "", "logo": "", "izin_publikasi_kontak": true, "kontak_wa": "628123456789", "instagram": "kerupukrambak.sri", "marketplace_url": "", "google_maps_url": "", "qris_image": "", "hasil_pendampingan": "<p>Tim KKN membantu pembuatan desain logo baru, pendaftaran QRIS, serta pelatihan dasar pemasaran digital melalui Instagram.</p>", "is_published": true, "is_featured": true, "created_at": "2026-08-12T16:16:31.260Z", "updated_at": "2026-08-12T16:16:31.260Z"}}, {"model": "umkm.umkm", "pk": 2, "fields": {"nama_usaha": "Kopi Bubuk Sumber Rasa", "slug": "kopi-bubuk-sumber-rasa", "nama_pemilik": "Bapak Budi Santoso", "kategori": 1, "dusun": "Dusun Balai Desa", "deskripsi": "<p>Produksi kopi bubuk robusta petik merah asli dari perkebunan lokal warga.</p>", "produk_unggulan": "Kopi Robusta Bubuk 100gr, Kopi Robusta Biji Sangrai", "foto_utama": "", "logo": "", "izin_publikasi_kontak": false, "kontak_wa": "", "instagram": "", "marketplace_url": "", "google_maps_url": "", "qris_image": "", "hasil_pendampingan": "", "is_published": true, "is_featured": true, "created_at": "2026-08-12T16:16:31.269Z", "updated_at": "2026-08-12T16:16:31.269Z"}}, {"model": "umkm.pendampinganbeforeafter", "pk": 1, "fields": {"umkm": 1, "jenis": "branding", "foto_sebelum": "", "foto_sesudah": "", "keterangan": "Pembuatan logo usaha agar produk lebih mudah dikenali di pasaran."}}, {"model": "umkm.pendampinganbeforeafter", "pk": 2, "fields": {"umkm": 1, "jenis": "qris", "foto_sebelum": "", "foto_sesudah": "", "keterangan": "Pendaftaran QRIS untuk memudahkan transaksi non-tunai pelanggan."}}, {"model": "umkm.pendampinganbeforeafter", "pk": 3, "fields": {"umkm": 2, "jenis": "kemasan", "foto_sebelum": "", "foto_sesudah": "", "keterangan": "Redesain kemasan dari plastik biasa menjadi pouch alumunium foil bersablon."}}, {"model": "artikel.kategoriartikel", "pk": 1, "fields": {"nama": "Desa", "slug": "desa", "warna_label": "primary"}}, {"model": "artikel.kategoriartikel", "pk": 2, "fields": {"nama": "UMKM", "slug": "umkm", "warna_label": "warning"}}, {"model": "artikel.kategoriartikel", "pk": 3, "fields": {"nama": "Kesehatan", "slug": "kesehatan", "warna_label": "danger"}}, {"model": "artikel.kategoriartikel", "pk": 4, "fields": {"nama": "Lingkungan", "slug": "lingkungan", "warna_label": "success"}}, {"model": "artikel.kategoriartikel", "pk": 5, "fields": {"nama": "Pertanian", "slug": "pertanian", "warna_label": "success"}}, {"model": "artikel.kategoriartikel", "pk": 6, "fields": {"nama": "Edukasi", "slug": "edukasi", "warna_label": "info"}}, {"model": "artikel.kategoriartikel", "pk": 7, "fields": {"nama": "Pemberdayaan", "slug": "pemberdayaan", "warna_label": "secondary"}}, {"model": "artikel.kategoriartikel", "pk": 8, "fields": {"nama": "Kegiatan", "slug": "kegiatan", "warna_label": "primary"}}, {"model": "artikel.artikel", "pk": 2, "fields": {"judul": "Pembangunan Infrastruktur Desa Tahap 1 Selesai", "slug": "pembangunan-infrastruktur-desa-tahap-1-selesai", "thumbnail": "", "kategori": 1, "penulis": "Tim KKN Undip", "tanggal_publish": "2026-07-10", "isi": "<p>Pembangunan infrastruktur berupa perbaikan jalan dusun tahap pertama telah rampung. Masyarakat kini dapat menikmati akses jalan yang lebih baik untuk aktivitas sehari-hari.</p><p>Kegiatan ini merupakan kolaborasi warga dan pemerintah desa setempat.</p>", "ringkasan": "Perbaikan jalan dusun tahap pertama telah selesai, memberikan kemudahan mobilitas bagi warga sekitar.", "is_published": true, "is_featured": true, "created_at": "2026-08-12T16:04:45.166Z", "updated_at": "2026-08-12T16:04:45.166Z"}}, {"model": "artikel.artikel", "pk": 3, "fields": {"judul": "Pelatihan Digital Marketing untuk UMKM Kerupuk Rambak", "slug": "pelatihan-digital-marketing-untuk-umkm-kerupuk-rambak", "thumbnail": "", "kategori": 2, "penulis": "Mahasiswa KKN", "tanggal_publish": "2026-07-15", "isi": "<p>Sebagai upaya meningkatkan penjualan UMKM, mahasiswa KKN mengadakan pelatihan pemasaran digital. Pelatihan ini memfokuskan penggunaan media sosial dan marketplace.</p>", "ringkasan": "Pelatihan pemasaran digital untuk memaksimalkan potensi penjualan UMKM kerupuk rambak.", "is_published": true, "is_featured": true, "created_at": "2026-08-12T16:04:45.169Z", "updated_at": "2026-08-12T16:04:45.169Z"}}, {"model": "artikel.artikel", "pk": 4, "fields": {"judul": "Kegiatan Posyandu Lansia Rutin Berjalan Lancar", "slug": "kegiatan-posyandu-lansia-rutin-berjalan-lancar", "thumbnail": "", "kategori": 3, "penulis": "Kader Posyandu", "tanggal_publish": "2026-07-20", "isi": "<p>Posyandu lansia bulan ini diikuti oleh puluhan warga. Pemeriksaan meliputi tensi, gula darah, dan kolesterol.</p>", "ringkasan": "Kegiatan rutin posyandu lansia mencakup cek kesehatan menyeluruh berjalan dengan sukses.", "is_published": true, "is_featured": true, "created_at": "2026-08-12T16:04:45.173Z", "updated_at": "2026-08-12T16:04:45.173Z"}}, {"model": "artikel.artikel", "pk": 5, "fields": {"judul": "Program Tanam Pohon Bersama Warga", "slug": "program-tanam-pohon-bersama-warga", "thumbnail": "", "kategori": 4, "penulis": "Tim KKN Undip", "tanggal_publish": "2026-08-01", "isi": "<p>Untuk menjaga kelestarian lingkungan, mahasiswa KKN bersama warga menanam ratusan bibit pohon di area resapan air desa.</p>", "ringkasan": "Penanaman ratusan bibit pohon di area resapan air desa demi menjaga kelestarian lingkungan.", "is_published": true, "is_featured": true, "created_at": "2026-08-12T16:04:45.176Z", "updated_at": "2026-08-12T16:04:45.176Z"}}, {"model": "artikel.artikel", "pk": 6, "fields": {"judul": "Inovasi Pupuk Organik dari Limbah Pertanian", "slug": "inovasi-pupuk-organik-dari-limbah-pertanian", "thumbnail": "", "kategori": 5, "penulis": "Mahasiswa Peternakan", "tanggal_publish": "2026-08-05", "isi": "<p>Limbah jerami dan kotoran ternak kini disulap menjadi pupuk organik cair yang sangat berguna bagi petani lokal.</p>", "ringkasan": "Inovasi pembuatan pupuk organik cair memanfaatkan limbah jerami dan kotoran ternak.", "is_published": true, "is_featured": true, "created_at": "2026-08-12T16:04:45.179Z", "updated_at": "2026-08-12T16:04:45.179Z"}}, {"model": "galeri.kategorigaleri", "pk": 1, "fields": {"nama": "Potensi Desa", "slug": "potensi-desa", "urutan": 0}}, {"model": "galeri.kategorigaleri", "pk": 2, "fields": {"nama": "Pertanian", "slug": "pertanian", "urutan": 1}}, {"model": "galeri.kategorigaleri", "pk": 3, "fields": {"nama": "UMKM", "slug": "umkm", "urutan": 2}}, {"model": "galeri.kategorigaleri", "pk": 4, "fields": {"nama": "Budaya", "slug": "budaya", "urutan": 3}}, {"model": "galeri.kategorigaleri", "pk": 5, "fields": {"nama": "Masyarakat", "slug": "masyarakat", "urutan": 4}}, {"model": "galeri.kategorigaleri", "pk": 6, "fields": {"nama": "Kegiatan", "slug": "kegiatan", "urutan": 5}}, {"model": "galeri.kategorigaleri", "pk": 7, "fields": {"nama": "Program Pemberdayaan", "slug": "program-pemberdayaan", "urutan": 6}}, {"model": "galeri.kategorigaleri", "pk": 8, "fields": {"nama": "KKN", "slug": "kkn", "urutan": 7}}, {"model": "galeri.itemgaleri", "pk": 2, "fields": {"foto": "galeri/placeholder.jpg", "judul": "Pemandangan Sawah", "deskripsi": "Potensi pertanian yang indah di sekitar dusun.", "kategori": 2, "tanggal": "2026-07-10", "is_published": true, "is_featured": true, "urutan": 0, "created_at": "2026-08-12T16:08:21.189Z"}}, {"model": "galeri.itemgaleri", "pk": 3, "fields": {"foto": "galeri/placeholder.jpg", "judul": "Kegiatan UMKM Rambak", "deskripsi": "Proses penjemuran kerupuk rambak oleh warga setempat.", "kategori": 3, "tanggal": "2026-07-15", "is_published": true, "is_featured": true, "urutan": 0, "created_at": "2026-